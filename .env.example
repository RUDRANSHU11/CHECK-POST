# Read by engine/__init__.py at import, from this directory only. Copy to .env
# (gitignored) and fill in. A variable already set in the shell wins.

# The recovery agent's LLM planner. Without a key it uses the rule planner and
# every number stays reproducible, which is why the demo does not need this.
# Get one at https://aistudio.google.com/apikey — real keys are 39 characters
# and start "AIza". Check it in five seconds: python -m agents.recovery
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Which ledger the API serves. The replay writes data/replay.db; the default
# below is an empty database, so point this at a run that happened before
# starting the server or the decision feed will be blank.
CHECKPOST_DB=data/checkpost.db

# Razorpay test mode only. Never a live key. Nothing reads these yet — no real
# money moves in this project.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
