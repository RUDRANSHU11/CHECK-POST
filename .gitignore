.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
*.db
*.sqlite3
out/*.json
out/*.md
!out/.gitkeep
web/node_modules/
web/.next/
.DS_Store

# Regenerated exactly by 'python -m harness.generate' from the recorded seed,
# so committing several MB of JSON would add nothing a command cannot rebuild.
data/*.json
.vercel

# ...except the three artifacts the deployment serves. Vercel builds from the
# repo, so whatever is not committed is absent at runtime: without these the
# function boots straight into "data/dataset.json missing" and every route
# 500s. They are still reproducible — `generate` then `replay` rewrites all
# three from the recorded seed — but "a command can rebuild it" stopped being
# enough once a push became a deploy.
!data/dataset.json
!data/replay.db
!out/scorecard.json
